---
const phone = "3155427324";
const paymentMsg = "¡Hola Macris! Acabo de realizar mi pago por medio digital. Adjunto el comprobante para agilizar mi despacho. 🧊🚀";

const paymentMethods = [
  {
    name: "Nequi",
    number: "315 542 73 24",
    borderColor: "border-[#330066]",
    iconColor: "text-[#330066]",
    hoverBg: "hover:bg-[#330066]/5",
    description: "Envía a través de tu app Nequi sin costo."
  },
  {
    name: "Daviplata",
    number: "315 542 73 24",
    borderColor: "border-[#DD0021]",
    iconColor: "text-[#DD0021]",
    hoverBg: "hover:bg-[#DD0021]/5",
    description: "Pago rápido desde cualquier cajero o app."
  },
  {
    name: "Bancolombia",
    number: "Ahorros: 123-456789-01",
    borderColor: "border-[#FDDA24]",
    iconColor: "text-slate-900", // Bancolombia usa negro sobre amarillo normalmente
    hoverBg: "hover:bg-[#FDDA24]/10",
    description: "Transferencias directas desde la App."
  }
];
---

<section id="pagos" class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="max-w-3xl mb-16">
      <h2 class="text-brand font-bold uppercase tracking-[0.4em] text-xs mb-4">Facilidad total</h2>
      <h3 class="text-5xl md:text-6xl font-black text-slate-900 leading-tight mb-6">
        Pagos <span class="text-brand">Digitales.</span>
      </h3>
      <p class="text-lg text-slate-600">
        Aceptamos los principales medios de pago electrónicos en Colombia para que recibas tu pedido sin complicaciones.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {paymentMethods.map((method) => (
        <div class={`rounded-[2.5rem] p-8 border-2 bg-transparent ${method.borderColor} ${method.hoverBg} transition-all duration-300 flex flex-col justify-between relative overflow-hidden group shadow-sm hover:shadow-xl`}>
          
          <div>
            <div class="flex justify-between items-start mb-10">
              <span class={`text-3xl font-black tracking-tighter italic ${method.iconColor}`}>{method.name}</span>
              <div class={`${method.iconColor} opacity-20 group-hover:opacity-100 transition-opacity`}>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
            </div>
            
            <p class="text-[10px] uppercase font-bold tracking-[0.2em] text-slate-400 mb-2">Número de cuenta / Celular</p>
            <h4 class="text-2xl font-black text-slate-800 mb-4">{method.number}</h4>
          </div>

          <div class="mt-4 pt-6 border-t border-slate-100">
            <p class="text-sm font-medium text-slate-500 leading-tight">{method.description}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12 bg-slate-50 border border-slate-200 rounded-[2rem] p-6 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center text-green-600 shrink-0">
           <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
           </svg>
        </div>
        <div class="text-center md:text-left">
          <p class="text-slate-900 font-bold text-sm italic">¿Ya realizaste tu pago?</p>
          <p class="text-slate-600 text-sm">Por favor envía el comprobante por WhatsApp para agilizar tu despacho.</p>
        </div>
      </div>

      <a 
        href={`https://wa.me/57${phone}?text=${encodeURIComponent(paymentMsg)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 bg-[#25D366] text-white px-8 py-4 rounded-2xl font-black text-sm hover:scale-105 transition-all shadow-xl shadow-green-500/20 active:scale-95"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.438 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
        ENVIAR COMPROBANTE
      </a>
    </div>

  </div>
</section>