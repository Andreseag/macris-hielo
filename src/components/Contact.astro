---
const phone = "3147047710";
const whatsappMsg = "Hola Macris! Necesito un servicio de hielo.";

const contactActions = [
  {
    label: "Llamada Directa",
    value: "314 704 7710",
    icon: "phone", // Identificador para el SVG
    href: `tel:+57${phone}`,
    bgIcon: "bg-blue-100",
    textColor: "text-brand",
    hoverBg: "group-hover:bg-brand",
    isExternal: false
  },
  {
    label: "Chat de Ventas",
    value: "WhatsApp",
    icon: "whatsapp",
    href: `https://wa.me/57${phone}?text=${encodeURIComponent(whatsappMsg)}`,
    bgIcon: "bg-green-100",
    textColor: "text-green-600",
    hoverBg: "group-hover:bg-[#25D366]",
    isExternal: true
  },
  {
    label: "Planta Física",
    value: "Cómo llegar",
    icon: "maps",
    href: "https://maps.google.com",
    bgIcon: "bg-red-50",
    textColor: "text-red-500",
    hoverBg: "group-hover:bg-red-500",
    isExternal: true
  }
];
---

<section id="contacto" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-brand border border-brand rounded-3xl overflow-hidden shadow-2xl">
      <div class="grid lg:grid-cols-2">
        
        <div class="p-8 md:p-16 text-white flex flex-col justify-center">
          <h2 class="text-3xl md:text-5xl font-black mb-6 leading-tight">
            ¿Listo para hacer <br/> <span class="text-blue-300">tu pedido?</span>
          </h2>
          <p class="text-blue-100 text-lg mb-10 max-w-md">
            Estamos disponibles para atenderte de inmediato. Ya sea para tu hogar, evento o proyecto de construcción en Villanueva, Casanare.
          </p>
        </div>

        <div class="bg-slate-50 p-8 md:p-16 flex flex-col justify-center gap-6">
          {contactActions.map((action) => (
            <a 
              href={action.href}
              target={action.isExternal ? "_blank" : "_self"}
              rel={action.isExternal ? "noopener noreferrer" : ""}
              class="flex items-center justify-between bg-white p-6 rounded-2xl shadow-sm border border-slate-400 hover:border-brand hover:shadow-md hover:scale-[1.02] transition-all group"
            >
              <div class="flex items-center gap-4">
                <div class={`w-12 h-12 ${action.bgIcon} rounded-full flex items-center justify-center ${action.textColor} ${action.hoverBg} group-hover:text-white transition-colors`}>
                  
                  {action.icon === 'phone' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                  )}
                  {action.icon === 'whatsapp' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 fill-current" viewBox="0 0 24 24">
                      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.438 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
                    </svg>
                  )}
                  {action.icon === 'maps' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  )}

                </div>
                <div>
                  <span class="block text-xs font-bold text-slate-400 uppercase tracking-widest">{action.label}</span>
                  <span class="text-lg font-black text-slate-800 tracking-tight">{action.value}</span>
                </div>
              </div>
              <span class="text-slate-500 group-hover:text-brand transition-colors">
                 <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </span>
            </a>
          ))}
        </div>

      </div>
    </div>
  </div>
</section>