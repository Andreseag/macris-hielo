---
const products = [
  {
    name: "Hielo en Bloque 10kg",
    description: "Bloque sólido de alta densidad. Ideal para eventos medianos, refrigeración comercial y conservación prolongada.",
    specs: "Bolsa de 10kg",
    href: "#contacto"
  },
  {
    name: "Hielo en Bloque 20kg",
    description: "Máxima duración y resistencia térmica. Perfecto para el sector industrial, transporte de alimentos y grandes eventos.",
    specs: "Bolsa de 20kg",
    href: "#contacto"
  }
];
---

<section id="productos" class="py-24 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="max-w-3xl mb-16">
      <h2 class="text-brand font-bold uppercase tracking-[0.4em] text-xs mb-4">Nuestra Producción</h2>
      <h3 class="text-5xl md:text-7xl font-black text-slate-900 leading-[0.9] mb-6">
        Potencia Fría <br/>
        <span class="text-brand">en cada Bloque.</span>
      </h3>
      <p class="text-xl text-slate-600 leading-relaxed border-l-4 border-brand/20 pl-6">
        No fabricamos solo hielo; entregamos <strong>resistencia térmica</strong>. 
        Nuestros bloques son el resultado de un proceso de congelación lenta y agua ultra-purificada, 
        garantizando que el frío dure mucho más tiempo donde más lo necesitas.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-10">
      {products.map((product) => (
        <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col group">
          
          <div class="w-full h-52 bg-blue-50/50 rounded-2xl mb-8 flex items-center justify-center border border-blue-100/50 overflow-hidden relative">
             <div class="absolute inset-0 bg-gradient-to-tr from-brand/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
             
             <svg xmlns="http://www.w3.org/2000/svg" class="w-20 h-20 text-brand/30 group-hover:scale-110 transition-transform duration-500 z-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
             </svg>
          </div>

          <div class="mb-8">
            <h4 class="text-3xl font-black text-slate-800 mb-4 tracking-tight">{product.name}</h4>
            <p class="text-slate-500 text-lg leading-relaxed font-medium">
              {product.description}
            </p>
          </div>

          <div class="mt-auto flex items-center justify-between pt-6 border-t border-slate-100">
            <div>
              <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] mb-1">Carga Neta</span>
              <span class="text-brand font-black text-2xl tracking-tighter">{product.specs}</span>
            </div>
            
            <a 
              href={product.href} 
              class="inline-flex items-center gap-3 px-8 py-4 rounded-2xl bg-brand text-white font-bold text-sm hover:bg-brand-dark transition-all shadow-lg shadow-brand/20 active:scale-95"
            >
              Pedir Ahora
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>