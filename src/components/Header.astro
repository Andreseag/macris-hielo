---
import { Image } from 'astro:assets';
import logoImage from '../assets/logo-macris.avif';

// IMPORTANTE: Pon '/Macris' si vas a GitHub Pages
// const base = '/Macris'; 
const base = '';

const navItems = [
  { name: 'Inicio', url: `${base}/` }, 
  { name: 'Nosotros', url: `${base}/nosotros` },
  { name: 'Productos', url: `${base}#productos` },
  { name: 'Puntos de venta', url: `${base}/#puntos-venta` },
  { name: 'Contacto', url: `${base}#contacto` },
];
---

<div id="header-spacer" class="w-full h-[80px] md:h-[180px]"></div>

<header id="main-header" class="fixed top-0 left-0 w-full bg-white border-b border-brand/10 shadow-sm z-50 transition-all duration-500">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex md:hidden justify-between items-center h-20">
      <a href={`${base}/`} class="w-32">
        <Image src={logoImage} alt="Logo Macris" width={150} height={60} class="h-10 w-auto object-contain" />
      </a>
      <button id="menu-open" class="p-2 text-brand focus:outline-none" aria-label="Abrir menú">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>

    <div id="logo-container-desktop" class="hidden md:flex flex-col items-center py-6 transition-all duration-500 overflow-hidden max-h-[200px]">
      <a href={`${base}/`} class="flex flex-col items-center group">
        <Image src={logoImage} alt="Logo Macris" width={260} height={100} class="h-auto w-64 object-contain" />
        <span class="text-[10px] uppercase tracking-[0.3em] font-bold text-slate-500 mt-1">Pureza y Resistencia</span>
      </a>
    </div>

    <nav id="nav-desktop" class="hidden md:flex items-center justify-center pb-4 transition-all duration-500">
      <div id="mini-logo-desktop" class="flex items-center w-0 opacity-0 -translate-x-5 pointer-events-none transition-all duration-500 overflow-hidden">
        <a href={`${base}/`} class="mr-6 shrink-3">
          <Image src={logoImage} alt="Logo Mini" width={100} height={40} class="h-8 w-auto object-contain" />
        </a>
      </div>
      <div class="flex items-center space-x-8">
        {navItems.map(item => (
          <a href={item.url} class="text-sm font-bold text-slate-600 hover:text-brand transition-colors uppercase tracking-wide">{item.name}</a>
        ))}
        <div class="h-6 w-px bg-slate-200 mx-2"></div>
        <a href="#pagos" class="bg-brand text-white px-6 py-2 rounded-full text-xs font-black shadow-md">PAGOS EN LÍNEA</a>
      </div>
    </nav>
  </div>

  <div id="mobile-menu" class="fixed inset-0 z-[60] translate-x-full transition-transform duration-300 ease-in-out pointer-events-none">
    <div id="menu-overlay" class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm"></div>
    <div class="absolute right-0 top-0 h-full w-4/5 max-w-sm bg-white p-8 pointer-events-auto">
      <div class="flex justify-end mb-8">
        <button id="menu-close" class="p-2 text-slate-500"><svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg></button>
      </div>
      <nav class="flex flex-col space-y-6">
        {navItems.map(item => (
          <a href={item.url} class="text-xl font-black text-slate-800 uppercase mobile-link">{item.name}</a>
        ))}
      </nav>
    </div>
  </div>
</header>

<script>
  function initHeader() {
    const header = document.getElementById('main-header');
    const menuOpen = document.getElementById('menu-open');
    const menuClose = document.getElementById('menu-close');
    const overlay = document.getElementById('menu-overlay');
    const mobileMenu = document.getElementById('mobile-menu');

    // Lógica de Scroll (Solo afecta visualmente al desktop)
    window.addEventListener('scroll', () => {
      if (window.scrollY > 80) {
        header?.classList.add('is-scrolled');
      } else {
        header?.classList.remove('is-scrolled');
      }
    }, { passive: true });

    // Lógica de Menú Mobile
    function toggleMenu() {
      mobileMenu?.classList.toggle('translate-x-full');
      mobileMenu?.classList.toggle('pointer-events-none');
      document.body.classList.toggle('overflow-hidden');
    }

    menuOpen?.addEventListener('click', toggleMenu);
    menuClose?.addEventListener('click', toggleMenu);
    overlay?.addEventListener('click', toggleMenu);

    // Cerrar al clickear links
    document.querySelectorAll('.mobile-link').forEach(link => {
      link.addEventListener('click', toggleMenu);
    });
  }

  document.addEventListener('astro:page-load', initHeader);
  initHeader();
</script>

<style>
  /* Escritorio: El logo grande se encoge */
  @media (min-width: 768px) {
    .is-scrolled #logo-container-desktop {
      max-height: 0;
      padding-top: 0;
      padding-bottom: 0;
      opacity: 0;
    }
    .is-scrolled #mini-logo-desktop {
      width: 120px;
      opacity: 1;
      transform: translateX(0);
      pointer-events: auto;
      margin-right: 1.5rem;
    }
    .is-scrolled #nav-desktop {
      padding-top: 1rem;
    }
  }

  /* Estilos generales */
  .is-scrolled {
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
  }
</style>